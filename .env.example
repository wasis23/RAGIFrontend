# ============================================================
# RAGIFrontend — contoh environment
# Salin ke .env.local (dev) atau set di Vercel Project Settings.
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_NAME="SSO Campus"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# --- Backend API (single-tenant, dipakai semua modul FE) ---
NEXT_PUBLIC_API_BASE_URL="https://api.example.com/api"
NEXT_PUBLIC_API_URL="https://api.example.com"
NEXT_PUBLIC_BACKEND_URL="https://api.example.com"

# --- Multi-tenant (FE-only) ---
# Root domain yang mendukung subdomain modul (mis. spmb.root -> /spmb).
# Boleh diisi via Edge Config `tenant_config.baseDomains` untuk ubah tanpa redeploy.
TENANT_BASE_DOMAINS="example.com"
# Daftar subdomain yang bukan modul (dipisah koma). Opsional.
TENANT_RESERVED_SUBDOMAINS="sso,www,api,mail,webmail,ftp,demo,demo-sso,ragife,ragibe"
# Salinan publik (dipakai fallback client-side; samakan dengan TENANT_BASE_DOMAINS).
NEXT_PUBLIC_BASE_DOMAINS="example.com"
# JSON object hostname -> module slug atau "default".
TENANT_DOMAIN_MAP='{}'

# --- Vercel Edge Config (runtime mapping domain -> modul) ---
# Connection string read-only dari Vercel > Storage > Edge Config.
EDGE_CONFIG=""
# ID Edge Config (untuk WRITE mapping via Vercel API). Bukan rahasia.
EDGE_CONFIG_ID=""

# --- Vercel REST API (kelola custom domain di /api/domains) ---
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
# Opsional bila project berada di Team.
VERCEL_TEAM_ID=""

# --- Kunci admin endpoint /api/domains ---
DOMAINS_ADMIN_SECRET=""

# --- Cloudflare Turnstile ---
# Site key publik dari dashboard Cloudflare > Turnstile > widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
