# ============================================================
# RAGI Frontend — environment example
# Salin ke .env.local atau isi di Vercel Project Settings.
# Variabel NEXT_PUBLIC_* dibundel ke client; jangan isi dengan secret.
# ============================================================

NEXT_PUBLIC_APP_NAME="RAGI Frontend"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_API_BASE_URL="https://api-ragi-indonusa.poltekindonusa.ac.id/api"
NEXT_PUBLIC_API_URL="https://api-ragi-indonusa.poltekindonusa.ac.id"
NEXT_PUBLIC_BACKEND_URL="https://api-ragi-indonusa.poltekindonusa.ac.id"

# Root domain untuk routing subdomain modul (tanpa scheme/path).
TENANT_BASE_DOMAINS="poltekindonusa.ac.id"
NEXT_PUBLIC_BASE_DOMAINS="poltekindonusa.ac.id"
TENANT_RESERVED_SUBDOMAINS=""
# JSON object hostname -> module slug atau "default".
TENANT_DOMAIN_MAP='{"spmb-new.poltekindonusa.ac.id":"spmb","sso.poltekindonusa.ac.id":"sso"}'

# Edge Config untuk tenant_config; EDGE_CONFIG adalah connection string rahasia.
EDGE_CONFIG=""
EDGE_CONFIG_ID=""

# Opsional: pengelolaan domain melalui API Vercel.
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
DOMAINS_ADMIN_SECRET=""

NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
