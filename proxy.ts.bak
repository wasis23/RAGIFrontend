import { NextRequest, NextResponse } from 'next/server';

const PUBLIC_ROUTES = ['/login', '/forgot-password', '/reset-password', '/verify-email', '/mfa'];
const ADMIN_ROUTE_PREFIX = '/admin';
const DASHBOARD = '/dashboard';

// Next.js 16 requires 'proxy' named export (or default)
export function proxy(request: NextRequest) {
  const { pathname } = request.nextUrl;

  const isPublicRoute = PUBLIC_ROUTES.some(
    (route) => pathname === route || pathname.startsWith(route + '/')
  );

  const token    = request.cookies.get('sso_access_token')?.value;
  const userType = request.cookies.get('sso_user_type')?.value;

  if (isPublicRoute && token) {
    return NextResponse.redirect(new URL(DASHBOARD, request.url));
  }

  if (!isPublicRoute && !token) {
    const loginUrl = new URL('/login', request.url);
    loginUrl.searchParams.set('redirect', pathname);
    return NextResponse.redirect(loginUrl);
  }

  if (pathname.startsWith(ADMIN_ROUTE_PREFIX) && userType !== 'admin') {
    return NextResponse.redirect(new URL('/403', request.url));
  }

  return NextResponse.next();
}

export const config = {
  matcher: [
    '/((?!_next/static|_next/image|favicon.ico|.*\\.(?:svg|png|jpg|jpeg|gif|webp)$|api/).*)',
  ],
};
