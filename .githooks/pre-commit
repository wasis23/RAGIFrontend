#!/bin/bash

echo "🚀 [AGY Agent Audit Runner] Menjalankan modul-modul pengujian..."

STAGED_DIFF=$(git diff --cached)

if [ -z "$STAGED_DIFF" ]; then
    echo "✅ [AGY Agent Audit] Tidak ada perubahan kode yang di-stage."
    exit 0
fi

HOOKS_DIR="$(dirname "$0")/audits"

if [ ! -d "$HOOKS_DIR" ]; then
    exit 0
fi

# ------------------------------------------------------------------------------
# TAHAP 1: Fast Deterministic Pre-checks (Fail-Fast: TypeScript & Hygiene)
# ------------------------------------------------------------------------------
if [ -x "$HOOKS_DIR/01-typecheck-and-hygiene.sh" ]; then
    "$HOOKS_DIR/01-typecheck-and-hygiene.sh"
    EXIT_CODE=$?
    if [ $EXIT_CODE -ne 0 ]; then
        echo "❌ [Fast Check] 01-typecheck-and-hygiene.sh gagal! Menghentikan proses audit."
        exit $EXIT_CODE
    fi
fi

# ------------------------------------------------------------------------------
# TAHAP 2: Deep AI Audits (02 & 03)
# ------------------------------------------------------------------------------
echo "⚡ [AGY Agent Audit Runner] Menjalankan modul audit AI secara berurutan..."

FAILED_AUDITS=()
TOTAL_FAILED=0

for script in "$HOOKS_DIR"/*.sh; do
    NAME=$(basename "$script")
    # Lewati script yang sudah dijalankan di Tahap 1
    if [ "$NAME" = "01-typecheck-and-hygiene.sh" ]; then
        continue
    fi

    if [ -x "$script" ]; then
        "$script"
        EXIT_CODE=$?
        if [ $EXIT_CODE -ne 0 ]; then
            TOTAL_FAILED=$((TOTAL_FAILED + 1))
            FAILED_AUDITS+=("$NAME")
        fi
    fi
done

if [ $TOTAL_FAILED -ne 0 ]; then
    echo ""
    echo "❌ ====================================================="
    echo "❌ COMMIT DITOLAK: Terdapat $TOTAL_FAILED modul audit yang gagal:"
    for failed in "${FAILED_AUDITS[@]}"; do
        echo "   - $failed"
    done
    echo "❌ ====================================================="
    echo "💡 Harap perbaiki masalah pada audit di atas sebelum commit."
    echo ""
    exit 1
fi

echo ""
echo "🎉 [AGY Agent Audit Runner] Seluruh modul pengujian independen PASSED! Commit dilanjutkan."
exit 0
